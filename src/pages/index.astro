// Technical placeholder: proves this code is connected to the existing
// Pathfinder CIC Wix Headless project. Read-only. Not a design.
// It will be replaced once the creative direction is approved.
import { posts } from "@wix/blog";
import { wixEventsV2 } from "@wix/events";

type Check = { label: string; ok: boolean; detail: string };

async function check(label: string, run: () => Promise<string>): Promise<Check> {
  try {
    return { label, ok: true, detail: await run() };
  } catch (error) {
    return { label, ok: false, detail: error instanceof Error ? error.message : String(error) };
  }
}

const checks = await Promise.all([
  check("Wix Events", async () => {
    const res = await wixEventsV2.queryEvents().limit(10).find();
    return `${res.items.length} event(s) returned`;
  }),
  check("Wix Blog", async () => {
    const res = await posts.queryPosts().limit(10).find();
    return `${res.items.length} post(s): ${res.items.map((p) => p.title).join(" · ")}`;
  }),
]);
