  </head>
  <body>
    <h1>Pathfinder CIC: connection test</h1>
    <p>Technical placeholder only. Not the website design.</p>
    <ul>
      {checks.map((c) => (
        <li data-check={c.label} data-ok={String(c.ok)}>
          <strong>{c.label}:</strong> {c.ok ? "connected" : "FAILED"} ({c.detail})
        </li>
      ))}
    </ul>
  </body>
